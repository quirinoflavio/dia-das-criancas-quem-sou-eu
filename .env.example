# Provedor de geração de imagem: "gemini" ou "fake" (para dev/testes sem custo)
IMAGE_PROVIDER=fake
# Chave da API do provedor (obrigatória se IMAGE_PROVIDER=gemini)
IMAGE_API_KEY=
# Modelo do provedor Gemini (opcional)
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Ciclo de vida das salas
ROOM_TTL_HOURS=24
# Upload
MAX_UPLOAD_MB=10
# Diretório de dados (imagens + snapshots)
DATA_DIR=./data

# CORS: origens permitidas em dev (separadas por vírgula). Em prod o front é
# servido pelo próprio backend, então pode ficar vazio.
CORS_ORIGINS=http://localhost:5173
